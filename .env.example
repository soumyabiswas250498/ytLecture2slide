# Backend reads this file from the repository root (or environment variables).
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
STORAGE_DIR=./storage
TEMP_DIR=./storage/jobs
DATABASE_PATH=./storage/database/app.db
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
DEFAULT_SEARCH_KEYWORD=IDO
# YouTube Data API v3 key (server-side only, never exposed to frontend or logs)
YOUTUBE_API_KEY=
DISCOVERY_LOOKBACK_DAYS=7
DISCOVERY_MIN_DURATION_SECONDS=1200
DISCOVERY_MAX_RESULTS_PER_CHANNEL=50
DISCOVERY_QUOTA_LIMIT=10000
DISCOVERY_SEARCH_QUOTA_LIMIT=100
DOWNLOAD_MAX_RESOLUTION=720
DOWNLOAD_AUDIO_ENABLED=false
DOWNLOAD_CONCURRENT_LIMIT=1
DOWNLOAD_RETRY_ATTEMPTS=3
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=30
DOWNLOAD_INACTIVITY_TIMEOUT_SECONDS=120
# Optional overall download timeout in seconds (unset = no hard cap for progressing downloads)
# DOWNLOAD_MAX_TOTAL_TIMEOUT_SECONDS=
DOWNLOAD_MIN_FREE_DISK_MB=500
# Optional override for video download directory (defaults to TEMP_DIR/videos)
# DOWNLOAD_DIR=./storage/jobs/videos
# Vite loads the root .env; rebuild frontend after changing VITE_* values.
VITE_API_URL=/api/v1
# Used by Vite's development proxy only.
BACKEND_PROXY_URL=http://127.0.0.1:8000
# Docker Compose publishes only the frontend on loopback.
FRONTEND_PORT=8080

# Frame extraction (lossless PNG, original resolution; sources always retained)
EXTRACTION_INTERVAL_SECONDS=60
EXTRACTION_CONCURRENT_LIMIT=1
EXTRACTION_RETRY_ATTEMPTS=3
EXTRACTION_MIN_FREE_DISK_MB=500
EXTRACTION_THREADS=1
EXTRACTION_PROGRESS_INTERVAL_SECONDS=2
# FRAME_DIR=./storage/jobs/frames
EXTRACTION_STRATEGY=seek
EXTRACTION_MAX_FRAMES=100000
EXTRACTION_MAX_FILTER_BYTES=32000

# YouTube challenge solving: Docker includes digest-pinned Deno and locked yt-dlp-ejs.
DOWNLOAD_JS_RUNTIME=deno
# Optional executable path; Docker defaults to /usr/local/bin/deno.
# DOWNLOAD_JS_RUNTIME_PATH=/usr/local/bin/deno
# Abandoned extraction generations only; active/recoverable/successful files and sources stay.
CLEANUP_RETENTION_HOURS=48
CLEANUP_DRY_RUN=false

# Phase 6: JSON overrides validated by SlideConfig (all thresholds are available).
SLIDE_PROCESSING={"adaptive_enabled":true,"adaptive_scale_with_duration":true,"adaptive_samples_per_hour":45,"max_additional_samples_cap":120,"additional_interval":5,"max_additional_samples":40,"save_diagnostics":false}
# Optional channel database IDs mapped to complete or partial SlideConfig profiles (SQLite channel_board_profiles takes precedence when present).
SLIDE_CHANNEL_PROFILES={}
SLIDE_CONCURRENT_LIMIT=1
SLIDE_RETRY_ATTEMPTS=3
